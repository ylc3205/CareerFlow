# =============================================================================
# CareerFlow Docker Compose Environment Overrides
# Copy this file to .env or pass with --env-file when customizing compose variables
# =============================================================================

# MongoDB Configuration
MONGO_PORT=27017

# Backend Configuration
BACKEND_PORT=5000
BACKEND_NODE_ENV=production
MONGODB_URI=mongodb://mongo:27017/careerflow
DATABASE_NAME=careerflow

# High-entropy JWT secrets for production
ACCESS_TOKEN_SECRET=replace-with-a-secure-random-32-character-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-another-secure-random-32-character-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Allowed CORS client domains (comma-separated)
CLIENT_URL=http://localhost,http://localhost:80,http://localhost:5173

# AI Provider Settings
# When AI_MOCK=false, provide a valid GEMINI_API_KEY
AI_MOCK=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storage Settings
# When STORAGE_MOCK=false, provide valid Cloudinary credentials
STORAGE_MOCK=true
STORAGE_MOCK_DIR=/app/.storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESUME_MAX_SIZE_MB=10

# Frontend Configuration
FRONTEND_PORT=80
VITE_API_URL=http://localhost:5000/api
