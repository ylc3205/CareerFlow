# Environment Variables — copy this file to .env and fill in your values

PORT=5000
HOST=0.0.0.0
MONGODB_URI=mongodb://localhost:27017/careerflow
DATABASE_NAME=careerflow
NODE_ENV=development

# Phase 2 — Authentication (use high-entropy secrets in production)
ACCESS_TOKEN_SECRET=your-access-token-secret-change-this
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS configuration (comma-separated origins allowed in production)
# Example: CLIENT_URL=http://localhost:5173,https://your-careerflow.vercel.app
CLIENT_URL=http://localhost:5173

# Phase 8 — AI
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MOCK=true

# Phase 20 — Resume CV upload / Cloudinary storage
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
STORAGE_MOCK=true
# STORAGE_MOCK_DIR=
RESUME_MAX_SIZE_MB=10
