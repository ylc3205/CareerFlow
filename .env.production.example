# ==============================================================================
# CAREERFLOW PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# File: .env.production.example
#
# USAGE INSTRUCTIONS ON VPS:
# 1. Copy this file to .env.production:
#    cp .env.production.example .env.production
# 2. Fill in all real credentials (MongoDB, Gemini, Cloudinary, JWT secrets).
# 3. Secure file permissions (deployer user only):
#    chmod 600 .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. MongoDB Database Connection
# ------------------------------------------------------------------------------
# Internal Docker bridge network connection to the container 'mongo:27017'
MONGODB_URI=mongodb://mongo:27017/careerflow
DATABASE_NAME=careerflow

# ------------------------------------------------------------------------------
# 3. Authentication Secrets & Token Expirations
# ------------------------------------------------------------------------------
# Generate 64-character high-entropy cryptographic secrets:
# Command: openssl rand -hex 32
ACCESS_TOKEN_SECRET=replace-with-64-character-hex-generated-via-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-another-64-character-hex-generated-via-openssl-rand-hex-32
REFRESH_TOKEN_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Allowed origins for web browsers (comma-separated if multiple)
# Do NOT put trailing slash.
CLIENT_URL=https://app.yourdomain.com

# ------------------------------------------------------------------------------
# 5. Google Gemini AI Service
# ------------------------------------------------------------------------------
# Set AI_MOCK=false for production to invoke real Google Gemini API
AI_MOCK=false
GEMINI_API_KEY=replace-with-your-real-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Optional Rate Limiting Overrides for AI
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=30

# ------------------------------------------------------------------------------
# 6. Cloudinary Storage (Resume / CV Uploads)
# ------------------------------------------------------------------------------
# Set STORAGE_MOCK=false to store uploaded PDF/DOCX resumes on Cloudinary CDN
STORAGE_MOCK=false
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
RESUME_MAX_SIZE_MB=10

# ------------------------------------------------------------------------------
# 7. Frontend Build Variables (Baked into Vite SPA Bundle)
# ------------------------------------------------------------------------------
# The public API URL reachable from client web browsers
VITE_API_URL=https://api.yourdomain.com/api
